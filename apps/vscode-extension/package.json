{
  "name": "kaveri-coding",
  "displayName": "Kaveri Coding",
  "description": "Kaveri Technologies coding assignments directly inside VS Code.",
  "version": "0.10.0",
  "publisher": "kaveritechnologies",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Narikparamala/kaveri-coding-workspace.git"
  },
  "main": "./server-extension.js",
  "scripts": {
    "package": "npx @vscode/vsce package --out kaveri-coding.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "kaveri.refreshAssignments",
        "title": "Kaveri: Refresh Assignments"
      },
      {
        "command": "kaveri.openAssignment",
        "title": "Kaveri: Open Assignment"
      },
      {
        "command": "kaveri.openWorkspaceFolder",
        "title": "Kaveri: Open Coding Folder"
      },
      {
        "command": "kaveri.runTests",
        "title": "Kaveri: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "kaveri.submitAnswer",
        "title": "Kaveri: Save Submission Locally"
      },
      {
        "command": "kaveri.submitOnline",
        "title": "Kaveri: Submit Answer",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kaveri.refreshResults",
        "title": "Kaveri: Refresh My Results",
        "icon": "$(refresh)"
      },
      {
        "command": "kaveri.openResult",
        "title": "Kaveri: Open Result"
      },
      {
        "command": "kaveri.joinBatch",
        "title": "Kaveri: Join Batch",
        "icon": "$(organization)"
      },
      {
        "command": "kaveri.signIn",
        "title": "Kaveri: Sign In with Google",
        "icon": "$(account)"
      },
      {
        "command": "kaveri.signOut",
        "title": "Kaveri: Sign Out"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kaveri-coding",
          "title": "Kaveri Coding",
          "icon": "resources/kaveri.svg"
        }
      ]
    },
    "views": {
      "kaveri-coding": [
        {
          "id": "kaveri.assignments",
          "name": "My Assignments"
        },
        {
          "id": "kaveri.results",
          "name": "My Results"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kaveri.signIn",
          "when": "view == kaveri.assignments",
          "group": "navigation@1"
        },
        {
          "command": "kaveri.joinBatch",
          "when": "view == kaveri.assignments",
          "group": "navigation@2"
        },
        {
          "command": "kaveri.refreshAssignments",
          "when": "view == kaveri.assignments",
          "group": "navigation@3"
        },
        {
          "command": "kaveri.openWorkspaceFolder",
          "when": "view == kaveri.assignments",
          "group": "navigation@4"
        },
        {
          "command": "kaveri.signIn",
          "when": "view == kaveri.results",
          "group": "navigation@1"
        },
        {
          "command": "kaveri.refreshResults",
          "when": "view == kaveri.results",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "kaveri.runTests",
          "when": "resourceExtname == .py",
          "group": "navigation@1"
        },
        {
          "command": "kaveri.submitOnline",
          "when": "resourceExtname == .py",
          "group": "navigation@2"
        }
      ]
    }
  }
}
