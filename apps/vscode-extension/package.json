{
  "name": "kaveri-coding",
  "displayName": "Kaveri Coding",
  "description": "Kaveri Technologies coding assignments directly inside VS Code.",
  "version": "0.4.0",
  "publisher": "kaveritechnologies",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./server-extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kaveri.refreshAssignments",
        "title": "Kaveri: Refresh Assignments"
      },
      {
        "command": "kaveri.openAssignment",
        "title": "Kaveri: Open Assignment"
      },
      {
        "command": "kaveri.openWorkspaceFolder",
        "title": "Kaveri: Open Coding Folder"
      },
      {
        "command": "kaveri.runTests",
        "title": "Kaveri: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "kaveri.submitAnswer",
        "title": "Kaveri: Save Submission Locally"
      },
      {
        "command": "kaveri.submitOnline",
        "title": "Kaveri: Submit Answer",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "kaveri.signIn",
        "title": "Kaveri: Sign In",
        "icon": "$(account)"
      },
      {
        "command": "kaveri.signOut",
        "title": "Kaveri: Sign Out"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kaveri-coding",
          "title": "Kaveri Coding",
          "icon": "resources/kaveri.svg"
        }
      ]
    },
    "views": {
      "kaveri-coding": [
        {
          "id": "kaveri.assignments",
          "name": "My Assignments"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kaveri.signIn",
          "when": "view == kaveri.assignments",
          "group": "navigation@1"
        },
        {
          "command": "kaveri.refreshAssignments",
          "when": "view == kaveri.assignments",
          "group": "navigation@2"
        },
        {
          "command": "kaveri.openWorkspaceFolder",
          "when": "view == kaveri.assignments",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "kaveri.runTests",
          "when": "resourceFilename == main.py",
          "group": "navigation@1"
        },
        {
          "command": "kaveri.submitOnline",
          "when": "resourceFilename == main.py",
          "group": "navigation@2"
        }
      ]
    }
  }
}
